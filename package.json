{
  "name": "happy-markdown",
  "displayName": "Happy Markdown",
  "description": "VS CodeでMarkdownを心地よく書くための、リッチな編集・プレビュー環境。",
  "version": "0.3.0",
  "publisher": "shio3ch",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shio3ch/happy-markdown.git"
  },
  "main": "./dist/src/extension.js",
  "scripts": {
    "test": "npm run build && node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce package",
    "build": "npm run typecheck && tsc -p tsconfig.json && node scripts/build.cjs",
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p webview/tsconfig.json"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.1.0",
    "sanitize-html": "^2.17.0"
  },
  "contributes": {
    "markdown.previewStyles": [
      "./styles/preview.css"
    ],
    "commands": [
      {
        "command": "happyMarkdown.openPreview",
        "title": "Happy Markdown: 専用画面を開く",
        "icon": "$(open-preview)"
      },
      {
        "command": "happyMarkdown.refreshExplorer",
        "title": "Happy Markdown: 一覧を更新",
        "icon": "$(refresh)"
      },
      {
        "command": "happyMarkdown.openSource",
        "title": "Happy Markdown: ソースを開く",
        "icon": "$(code)"
      },
      {
        "command": "happyMarkdown.showFiles",
        "title": "Happy Markdown: ファイル一覧に切り替え",
        "icon": "$(files)"
      },
      {
        "command": "happyMarkdown.showSearch",
        "title": "Happy Markdown: 本文検索に切り替え",
        "icon": "$(search)"
      },
      {
        "command": "happyMarkdown.showBookmarks",
        "title": "Happy Markdown: ブックマークに切り替え",
        "icon": "$(bookmark)"
      },
      {
        "command": "happyMarkdown.addBookmark",
        "title": "Happy Markdown: ブックマークに追加",
        "icon": "$(bookmark)"
      },
      {
        "command": "happyMarkdown.removeBookmark",
        "title": "Happy Markdown: ブックマークから削除",
        "icon": "$(bookmark-slash)"
      },
      {
        "command": "happyMarkdown.enableFollowActive",
        "title": "Happy Markdown: 現在の文書への追従をオン",
        "icon": "$(eye-closed)"
      },
      {
        "command": "happyMarkdown.disableFollowActive",
        "title": "Happy Markdown: 現在の文書への追従をオフ",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "editor/title": [],
      "view/title": [
        {
          "command": "happyMarkdown.showFiles",
          "when": "(view == happyMarkdown.explorer || view == happyMarkdown.search)",
          "group": "navigation@1"
        },
        {
          "command": "happyMarkdown.showSearch",
          "when": "(view == happyMarkdown.explorer || view == happyMarkdown.search)",
          "group": "navigation@2"
        },
        {
          "command": "happyMarkdown.showBookmarks",
          "when": "(view == happyMarkdown.explorer || view == happyMarkdown.search)",
          "group": "navigation@3"
        },
        {
          "command": "happyMarkdown.refreshExplorer",
          "when": "(view == happyMarkdown.explorer || view == happyMarkdown.search)",
          "group": "navigation@4"
        },
        {
          "command": "happyMarkdown.enableFollowActive",
          "when": "(view == happyMarkdown.explorer || view == happyMarkdown.search) && !happyMarkdown.followActive",
          "group": "navigation@5"
        },
        {
          "command": "happyMarkdown.disableFollowActive",
          "when": "(view == happyMarkdown.explorer || view == happyMarkdown.search) && happyMarkdown.followActive",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "happyMarkdown.openSource",
          "when": "view == happyMarkdown.explorer && viewItem =~ /^(markdownFile|bookmarkedMarkdownFile)$/",
          "group": "inline"
        },
        {
          "command": "happyMarkdown.addBookmark",
          "when": "view == happyMarkdown.explorer && viewItem == markdownFile",
          "group": "inline@1"
        },
        {
          "command": "happyMarkdown.removeBookmark",
          "when": "view == happyMarkdown.explorer && viewItem == bookmarkedMarkdownFile",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "happyMarkdown.openSource",
          "when": "false"
        },
        {
          "command": "happyMarkdown.addBookmark",
          "when": "false"
        },
        {
          "command": "happyMarkdown.removeBookmark",
          "when": "false"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "happyMarkdown.preview",
        "displayName": "Happy Markdown",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "happyMarkdown",
          "title": "Happy Markdown",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "happyMarkdown": [
        {
          "id": "happyMarkdown.explorer",
          "name": "Markdownエクスプローラー",
          "when": "happyMarkdown.explorerMode != search"
        },
        {
          "type": "webview",
          "id": "happyMarkdown.search",
          "name": "Markdownエクスプローラー",
          "when": "happyMarkdown.explorerMode == search"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "happyMarkdown.explorer",
        "contents": "Markdownを読むフォルダーを開いてください。\n[フォルダーを開く](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      }
    ]
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "@types/vscode": "1.100.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
