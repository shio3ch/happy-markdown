{
  "name": "happy-markdown",
  "displayName": "Happy Markdown",
  "description": "VS CodeでMarkdownを心地よく書くための、リッチな編集・プレビュー環境。",
  "version": "0.3.0",
  "publisher": "shio3ch",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shio3ch/happy-markdown.git"
  },
  "main": "./dist/extension/extension.js",
  "scripts": {
    "test": "npm run build && node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce package",
    "build": "npm run typecheck && npm run clean && tsc -p tsconfig.json && node scripts/build.cjs",
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p src/webview/tsconfig.json",
    "clean": "node scripts/clean.cjs"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.1.0",
    "sanitize-html": "^2.17.0"
  },
  "contributes": {
    "markdown.previewStyles": [
      "./styles/preview.css"
    ],
    "commands": [
      {
        "command": "happyMarkdown.openPreview",
        "title": "Happy Markdown: 専用画面を開く",
        "icon": "$(open-preview)"
      },
      {
        "command": "happyMarkdown.refreshExplorer",
        "title": "Happy Markdown: 一覧を更新",
        "icon": "$(refresh)"
      },
      {
        "command": "happyMarkdown.openSource",
        "title": "Happy Markdown: ソースを開く",
        "icon": "$(code)"
      },
      {
        "command": "happyMarkdown.showFiles",
        "title": "Happy Markdown: ファイル一覧に切り替え",
        "icon": "$(files)"
      },
      {
        "command": "happyMarkdown.showSearch",
        "title": "Happy Markdown: 本文検索に切り替え",
        "icon": "$(search)"
      },
      {
        "command": "happyMarkdown.showBookmarks",
        "title": "Happy Markdown: ブックマークに切り替え",
        "icon": "$(bookmark)"
      },
      {
        "command": "happyMarkdown.addBookmark",
        "title": "Happy Markdown: ブックマークに追加",
        "icon": "$(bookmark)"
      },
      {
        "command": "happyMarkdown.removeBookmark",
        "title": "Happy Markdown: ブックマークから削除",
        "icon": "$(bookmark-slash)"
      },
      {
        "command": "happyMarkdown.enableFollowActive",
        "title": "Happy Markdown: 現在の文書への追従をオン",
        "icon": "$(eye-closed)"
      },
      {
        "command": "happyMarkdown.disableFollowActive",
        "title": "Happy Markdown: 現在の文書への追従をオフ",
        "icon": "$(eye)"
      },
      {
        "command": "happyMarkdown.explorer.newFile",
        "title": "Happy Markdown: エクスプローラーでファイルを新規作成"
      },
      {
        "command": "happyMarkdown.explorer.newFolder",
        "title": "Happy Markdown: エクスプローラーでフォルダーを新規作成"
      },
      {
        "command": "happyMarkdown.explorer.duplicate",
        "title": "Happy Markdown: エクスプローラーでファイルを複製"
      },
      {
        "command": "happyMarkdown.explorer.copy",
        "title": "Happy Markdown: エクスプローラーでファイルをコピー"
      },
      {
        "command": "happyMarkdown.explorer.cut",
        "title": "Happy Markdown: エクスプローラーでファイルを切り取り"
      },
      {
        "command": "happyMarkdown.explorer.paste",
        "title": "Happy Markdown: エクスプローラーでファイルを貼り付け"
      },
      {
        "command": "happyMarkdown.explorer.copyPath",
        "title": "Happy Markdown: エクスプローラーでパスをコピー"
      },
      {
        "command": "happyMarkdown.explorer.copyRelativePath",
        "title": "Happy Markdown: エクスプローラーで相対パスをコピー"
      },
      {
        "command": "happyMarkdown.explorer.rename",
        "title": "Happy Markdown: エクスプローラーで名前を変更"
      },
      {
        "command": "happyMarkdown.explorer.delete",
        "title": "Happy Markdown: エクスプローラーで削除"
      },
      {
        "command": "happyMarkdown.explorer.openTab",
        "title": "Happy Markdown: エクスプローラーでファイルを通常タブで開く"
      },
      {
        "command": "happyMarkdown.explorer.openSide",
        "title": "Happy Markdown: エクスプローラーでファイルを横に開く"
      },
      {
        "command": "happyMarkdown.explorer.openPreview",
        "title": "Happy Markdown: エクスプローラーでフォーカスを残してファイルを表示"
      },
      {
        "command": "happyMarkdown.explorer.cancelCut",
        "title": "Happy Markdown: エクスプローラーで切り取りを解除"
      },
      {
        "command": "happyMarkdown.explorer.contextMenu",
        "title": "Happy Markdown: エクスプローラーでコンテキストメニューを開く"
      },
      {
        "command": "happyMarkdown.explorer.toggleFolder",
        "title": "Happy Markdown: エクスプローラーでフォルダーを開閉"
      }
    ],
    "menus": {
      "editor/title": [],
      "view/title": [],
      "commandPalette": [
        {
          "command": "happyMarkdown.openSource",
          "when": "false"
        },
        {
          "command": "happyMarkdown.addBookmark",
          "when": "false"
        },
        {
          "command": "happyMarkdown.removeBookmark",
          "when": "false"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "happyMarkdown.preview",
        "displayName": "Happy Markdown",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "happyMarkdown",
          "title": "Happy Markdown",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "happyMarkdown": [
        {
          "type": "webview",
          "id": "happyMarkdown.explorer",
          "name": "Markdownエクスプローラー"
        }
      ]
    },
    "keybindings": [
      {
        "command": "happyMarkdown.explorer.rename",
        "key": "f2",
        "mac": "enter",
        "when": "happyMarkdown.explorerTreeFocus && !happyMarkdown.explorerBusy && happyMarkdown.explorerHasSelection && !happyMarkdown.explorerRootSelected",
        "args": {
          "fromKeybinding": true
        }
      },
      {
        "command": "happyMarkdown.explorer.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "happyMarkdown.explorerTreeFocus && !happyMarkdown.explorerBusy && happyMarkdown.explorerHasSelection && !happyMarkdown.explorerRootSelected",
        "args": {
          "fromKeybinding": true
        }
      },
      {
        "command": "happyMarkdown.explorer.delete",
        "key": "delete",
        "when": "happyMarkdown.explorerTreeFocus && !happyMarkdown.explorerBusy && happyMarkdown.explorerHasSelection && !happyMarkdown.explorerRootSelected && isMac",
        "args": {
          "fromKeybinding": true
        }
      },
      {
        "command": "happyMarkdown.explorer.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "happyMarkdown.explorerTreeFocus && !happyMarkdown.explorerBusy && happyMarkdown.explorerFileSelected",
        "args": {
          "fromKeybinding": true
        }
      },
      {
        "command": "happyMarkdown.explorer.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "happyMarkdown.explorerTreeFocus && !happyMarkdown.explorerBusy && happyMarkdown.explorerFileSelected",
        "args": {
          "fromKeybinding": true
        }
      },
      {
        "command": "happyMarkdown.explorer.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "happyMarkdown.explorerTreeFocus && !happyMarkdown.explorerBusy && happyMarkdown.explorerHasWorkspace && happyMarkdown.explorerCanPaste",
        "args": {
          "fromKeybinding": true
        }
      },
      {
        "command": "happyMarkdown.explorer.copyPath",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "win": "shift+alt+c",
        "when": "happyMarkdown.explorerTreeFocus && !happyMarkdown.explorerBusy && happyMarkdown.explorerHasSelection",
        "args": {
          "fromKeybinding": true
        }
      },
      {
        "command": "happyMarkdown.explorer.copyRelativePath",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c",
        "win": "ctrl+k ctrl+shift+c",
        "when": "happyMarkdown.explorerTreeFocus && !happyMarkdown.explorerBusy && happyMarkdown.explorerHasSelection",
        "args": {
          "fromKeybinding": true
        }
      },
      {
        "command": "happyMarkdown.explorer.openTab",
        "key": "enter",
        "mac": "cmd+down",
        "when": "happyMarkdown.explorerTreeFocus && !happyMarkdown.explorerBusy && happyMarkdown.explorerFileSelected",
        "args": {
          "fromKeybinding": true
        }
      },
      {
        "command": "happyMarkdown.explorer.openPreview",
        "key": "space",
        "when": "happyMarkdown.explorerTreeFocus && !happyMarkdown.explorerBusy && happyMarkdown.explorerFileSelected",
        "args": {
          "fromKeybinding": true
        }
      },
      {
        "command": "happyMarkdown.explorer.openSide",
        "key": "ctrl+enter",
        "when": "happyMarkdown.explorerTreeFocus && !happyMarkdown.explorerBusy && happyMarkdown.explorerFileSelected",
        "args": {
          "fromKeybinding": true
        }
      },
      {
        "command": "happyMarkdown.explorer.cancelCut",
        "key": "escape",
        "when": "happyMarkdown.explorerTreeFocus && !happyMarkdown.explorerBusy && happyMarkdown.explorerHasCut",
        "args": {
          "fromKeybinding": true
        }
      },
      {
        "command": "happyMarkdown.explorer.contextMenu",
        "key": "shift+f10",
        "when": "happyMarkdown.explorerTreeFocus && !happyMarkdown.explorerBusy",
        "args": {
          "fromKeybinding": true
        }
      },
      {
        "command": "happyMarkdown.explorer.toggleFolder",
        "key": "enter",
        "when": "happyMarkdown.explorerTreeFocus && !happyMarkdown.explorerBusy && happyMarkdown.explorerFolderSelected && !isMac",
        "args": {
          "fromKeybinding": true
        }
      }
    ]
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/vscode": "1.100.0",
    "dompurify": "^3.4.18",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2"
  }
}
