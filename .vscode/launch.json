{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Happy Markdown: 拡張をデバッグ",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "${workspaceFolder}/wiki",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "--profile-temp",
        "${workspaceFolder}/wiki/README.md"
      ],
      "trace": true,
      "preLaunchTask": "Happy Markdown: build"
    }
  ]
}
